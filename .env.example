# Copy to .env and adjust. Never commit the real .env.

# --- Database -------------------------------------------------------------
# Local Homebrew Postgres (no password, trust auth):
DATABASE_URL="postgresql://postgres@localhost:5432/equipment_cleaning_log?schema=public"
# Docker Compose (see docker-compose.yml):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/equipment_cleaning_log?schema=public"

# Separate database used by the integration test suite. It is TRUNCATED between
# tests, so it must never point at a database you care about.
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/equipment_cleaning_log_test?schema=public"

# --- API ------------------------------------------------------------------
NODE_ENV="development"
PORT="4000"
# Any string of 32+ characters. Generate one with: openssl rand -base64 48
JWT_SECRET="dev-only-secret-change-me-in-production-0123456789"
JWT_EXPIRES_IN="8h"
# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL="info"

# --- Web ------------------------------------------------------------------
VITE_API_URL="http://localhost:4000"

# --- Deployment -----------------------------------------------------------
# Nothing below is read from a file in production. config/env.ts only loads a
# .env if it finds one, so on a host you set real environment variables and
# this file is irrelevant. See the Deployment section of README.md.
#
# On the API host (Render):
#   DATABASE_URL   the Neon connection string (the direct one, not -pooler)
#   JWT_SECRET     openssl rand -base64 48   — 32 chars minimum, or no boot
#   CORS_ORIGIN    https://your-app.vercel.app   (exact, no trailing slash)
#   NODE_ENV       production
#   NODE_VERSION   24   (Prisma 7 rejects odd-numbered Node majors)
#   PORT           do not set — the platform injects it
#
# On the web host (Vercel):
#   VITE_API_URL   https://your-api.onrender.com   (no trailing slash)
#
# VITE_API_URL is inlined into the bundle at BUILD time, so changing it means
# redeploying the web app. TEST_DATABASE_URL is never needed in production.
